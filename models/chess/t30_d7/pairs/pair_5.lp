% class_1=14 (thirteen), class_2=15 (fourteen)

item(1).
bin(1,0,2).       % f0 (1.5, 2.5]
bin(1,1,1).       % f1 (1.5, 2.5]
bin(1,2,5).       % f2 (4.5, 5.5]
bin(1,3,5).       % f3 (5.5, 6.5]
bin(1,4,3).       % f4 (2, 2.5]
bin(1,5,5).       % f5 (6.5, 7.5]

item(2).
bin(2,0,2).       % f0 (1.5, 2.5]
bin(2,1,0).       % f1 <= 1.5
bin(2,2,2).       % f2 (1.5, 2.5]
bin(2,3,3).       % f3 (3.5, 4.5]
bin(2,4,2).       % f4 (1.5, 2]
bin(2,5,3).       % f5 (3.5, 5.5]
