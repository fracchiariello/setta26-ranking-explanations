% class_1=15 (fourteen), class_2=15 (fourteen)

item(1).
bin(1,0,1).       % f0 (0.5, 1.5]
bin(1,1,1).       % f1 (1.5, 2.5]
bin(1,2,0).       % f2 <= 0.5
bin(1,3,3).       % f3 (3.5, 4.5]
bin(1,4,8).       % f4 (5.5, 6.5]
bin(1,5,3).       % f5 (3.5, 5.5]

item(2).
bin(2,0,1).       % f0 (0.5, 1.5]
bin(2,1,3).       % f1 > 3.5
bin(2,2,4).       % f2 (3.5, 4.5]
bin(2,3,0).       % f3 <= 1.5
bin(2,4,2).       % f4 (1.5, 2]
bin(2,5,5).       % f5 (6.5, 7.5]
