% class_1=3 (two), class_2=6 (five)

item(1).
bin(1,0,0).       % f0 <= 0.5
bin(1,1,2).       % f1 (2.5, 3.5]
bin(1,2,6).       % f2 (5.5, 6.5]
bin(1,3,4).       % f3 (4.5, 5.5]
bin(1,4,1).       % f4 (0.5, 1.5]
bin(1,5,1).       % f5 (1.5, 2.5]

item(2).
bin(2,0,3).       % f0 > 2.5
bin(2,1,2).       % f1 (2.5, 3.5]
bin(2,2,3).       % f2 (2.5, 3.5]
bin(2,3,5).       % f3 (5.5, 6.5]
bin(2,4,0).       % f4 <= 0.5
bin(2,5,1).       % f5 (1.5, 2.5]
