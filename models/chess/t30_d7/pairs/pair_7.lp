% class_1=11 (ten), class_2=13 (twelve)

item(1).
bin(1,0,2).       % f0 (1.5, 2.5]
bin(1,1,1).       % f1 (1.5, 2.5]
bin(1,2,7).       % f2 > 6.5
bin(1,3,6).       % f3 (6.5, 7.5]
bin(1,4,7).       % f4 (4.5, 5.5]
bin(1,5,1).       % f5 (1.5, 2.5]

item(2).
bin(2,0,2).       % f0 (1.5, 2.5]
bin(2,1,1).       % f1 (1.5, 2.5]
bin(2,2,3).       % f2 (2.5, 3.5]
bin(2,3,4).       % f3 (4.5, 5.5]
bin(2,4,9).       % f4 > 6.5
bin(2,5,3).       % f5 (3.5, 5.5]
