% class_1=13 (twelve), class_2=15 (fourteen)

item(1).
bin(1,0,3).       % f0 > 2.5
bin(1,1,2).       % f1 (2.5, 3.5]
bin(1,2,3).       % f2 (2.5, 3.5]
bin(1,3,2).       % f3 (2.5, 3.5]
bin(1,4,8).       % f4 (5.5, 6.5]
bin(1,5,3).       % f5 (3.5, 5.5]

item(2).
bin(2,0,0).       % f0 <= 0.5
bin(2,1,0).       % f1 <= 1.5
bin(2,2,1).       % f2 (0.5, 1.5]
bin(2,3,2).       % f3 (2.5, 3.5]
bin(2,4,2).       % f4 (1.5, 2]
bin(2,5,6).       % f5 > 7.5
