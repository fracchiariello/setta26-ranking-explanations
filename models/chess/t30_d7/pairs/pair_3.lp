% class_1=9 (eight), class_2=9 (eight)

item(1).
bin(1,0,2).       % f0 (1.5, 2.5]
bin(1,1,2).       % f1 (2.5, 3.5]
bin(1,2,0).       % f2 <= 0.5
bin(1,3,7).       % f3 > 7.5
bin(1,4,8).       % f4 (5.5, 6.5]
bin(1,5,0).       % f5 <= 1.5

item(2).
bin(2,0,3).       % f0 > 2.5
bin(2,1,0).       % f1 <= 1.5
bin(2,2,4).       % f2 (3.5, 4.5]
bin(2,3,5).       % f3 (5.5, 6.5]
bin(2,4,9).       % f4 > 6.5
bin(2,5,1).       % f5 (1.5, 2.5]
