% class_1=15 (fourteen), class_2=15 (fourteen)

item(1).
bin(1,0,0).       % f0 <= 0.5
bin(1,1,0).       % f1 <= 1.5
bin(1,2,3).       % f2 (2.5, 3.5]
bin(1,3,4).       % f3 (4.5, 5.5]
